# ==============================================================================
# IT-HUB ERP — Enterprise Environment Configuration Blueprint
# Copy this file to .env.local for local development.
# CAUTION: Never commit .env.local or production secrets to Git.
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_APP_NAME="IT-HUB ERP"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-Tenancy & Workspace Defaults
NEXT_PUBLIC_DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"
NEXT_PUBLIC_DEFAULT_WORKSPACE="IT-HUB Global Technologies Corp"

# Supabase PostgreSQL & Auth Credentials
# 1. Project URL (Public): Found in Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project-id.supabase.co"

# 2. Anon Public API Key: Safe for browser usage. RLS is strictly enforced for all queries.
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-public-jwt-token"

# 3. Service Role Secret Key: HIGH PRIVILEGE. Bypasses RLS.
# STRICT RULE: NEVER prefix with NEXT_PUBLIC_. Only used in server-side scripts / migration bootstrap.
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-private-jwt-key"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING="true"

# Optional Email Notification Provider (Server-Side Only - Fails Safely If Unconfigured)
# Option A: SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-secret-key"
SMTP_FROM="notifications@yourdomain.com"
# Option B: Resend API
RESEND_API_KEY="re_placeholder_secret_key"

# Production Session & Encryption Secrets
SESSION_SECRET="generate-a-secure-random-64-char-string-for-cookie-sealing"
