# ==============================================================================
# IT-HUB ERP — Environment Configuration Blueprint (Phase 1)
# Copy this file to .env.local for local development. Never commit .env.local to Git.
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_APP_NAME="IT-HUB ERP"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-Tenancy & Workspace Defaults
NEXT_PUBLIC_DEFAULT_TENANT_ID="tenant-it-hub-demo"
NEXT_PUBLIC_DEFAULT_WORKSPACE="IT-HUB Corporation Global"

# Supabase Persistence & Authentication (Planned Backend Integration)
# Replace with safe local/sandbox keys when backend integration is activated in Phase 2
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-public-jwt-token"
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-private-jwt-key"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING="true"
