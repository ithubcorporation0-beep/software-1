# ==============================================================================
# IT-HUB ERP — Environment Configuration Blueprint
# Copy this file to .env and configure appropriate values
# ==============================================================================

# Application Meta
VITE_APP_NAME="IT-HUB ERP"
VITE_APP_ENV="development" # development | staging | production
VITE_APP_URL="http://localhost:5173"

# Supabase Production Database & Auth (Optional Cloud Sync)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Offline Storage & Features
VITE_ENABLE_OFFLINE_STORAGE="true"
VITE_ENABLE_AUDIT_LOGS="true"
VITE_DEFAULT_THEME="dark"
